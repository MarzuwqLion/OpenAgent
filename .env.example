# ─── Slack (required) ────────────────────────────────────────────────
# Bot User OAuth Token (OAuth & Permissions page)
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with the connections:write scope (Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-...
# Channel that scheduled skills post to when their frontmatter `channel` is empty
SLACK_DEFAULT_CHANNEL=C0123456789

# A07: who may talk to the bot, run slash commands and click Approve/Reject.
# Comma-separated Slack member IDs (profile → ⋯ → Copy member ID). Required.
ALLOWED_SLACK_USER_IDS=

# ─── Models (at least one provider key, or CUSTOM_BASE_URL, is required) ───
# Format: provider:model — providers are anthropic, openai, google, openrouter,
# deepseek, xai (Grok, e.g. xai:grok-4), custom
DEFAULT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# xAI / Grok (GROK_API_KEY is accepted as an alias)
XAI_API_KEY=

# Optional OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, ...). Models are
# addressed as custom:<model>. CUSTOM_API_KEY may be blank for local servers.
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ─── Behaviour ───────────────────────────────────────────────────────
# A18: IANA time zone for skill schedules (containers default to UTC otherwise)
TZ=America/New_York
# A08: always = every bash command needs approval;
#      allowlist = simple read-only commands (ls, cat, grep, ...) run without approval
BASH_APPROVAL_MODE=always
# A06: oldest messages beyond this are dropped from each thread's history
HISTORY_MAX_MESSAGES=120

# Optional: where agent.db, MEMORY.md, skills/ and workspace/ live (default ./data)
# DATA_DIR=./data
